    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst normalizedData = items.map((item) => {\n  const data = item.json;\n  const fields = data.body.data.fields;\n  const normalizedFields = fields.reduce((acc, field) => {\n    let value = field.value;\n    // Tally dropdown / multiple-choice fields arrive as arrays of internal\n    // option IDs. Resolve them to their human-readable text labels.\n    if (Array.isArray(value) && Array.isArray(field.options)) {\n      const labels = value.map((id) => {\n        const opt = field.options.find((o) => o.id === id);\n        return opt ? opt.text : id;\n      });\n      value = labels.join(', ');\n    }\n    acc[field.key] = value;\n    return acc;\n  }, {});\n  return normalizedFields;\n});\nreturn normalizedData;\n"
      },
      "id": "8e3969ef-7143-4544-b648-6304dd4598c2",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract score, reasoning and tag from the Gemini model output as separate variables.\n// The model returns its JSON as a string inside content.parts[0].text (and sometimes\n// wrapped in markdown code fences), so we locate and parse it defensively.\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const json = item.json || {};\n\n  // Find the raw payload: either already-parsed top-level fields, or the text part.\n  let parsed = null;\n\n  if (json.score !== undefined || json.tag !== undefined || json.reasoning !== undefined) {\n    parsed = json;\n  } else {\n    const rawText = json?.content?.parts?.[0]?.text ?? json?.text ?? '';\n    if (rawText) {\n      // Strip markdown code fences if present, then grab the first {...} block.\n      const cleaned = String(rawText).replace(/```(?:json)?/gi, '').trim();\n      const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n      const toParse = match ? match[0] : cleaned;\n      try {\n        parsed = JSON.parse(toParse);\n      } catch (e) {\n        parsed = {};\n      }\n    } else {\n      parsed = {};\n    }\n  }\n\n  const score = parsed.score !== undefined ? Number(parsed.score) : null;\n  const reasoning = parsed.reasoning ?? null;\n  let tag = parsed.tag ?? null;\n\n  // Derive tag from score if the model omitted it.\n  if (!tag && score !== null && !Number.isNaN(score)) {\n    tag = score >= 8 ? 'Hot' : score >= 5 ? 'Warm' : 'Cold';\n  }\n\n  results.push({ json: { score, tag, reasoning } });\n}\n\nreturn results;\n"
      },
